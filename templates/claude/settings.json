{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.orchestrator/hooks/decision-index.sh\"",
            "timeout": 10,
            "statusMessage": "Loading the decision index",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.orchestrator/hooks/update-check.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for orchestrator updates",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.orchestrator/hooks/telemetry.sh\" hook claude",
            "timeout": 10,
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.orchestrator/hooks/telemetry.sh\" hook claude",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.orchestrator/hooks/telemetry.sh\" hook claude",
            "timeout": 10,
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.orchestrator/hooks/telemetry.sh\" hook claude",
            "timeout": 10,
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.orchestrator/hooks/telemetry.sh\" hook claude",
            "timeout": 10,
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.orchestrator/hooks/telemetry.sh\" hook claude",
            "timeout": 10,
            "shell": "bash",
            "async": true
          }
        ]
      }
    ]
  },
  "skillListingMaxDescChars": 300,
  "autoCompactWindow": 150000,
  "env": {
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "100000"
  },
  "enabledPlugins": {}
}
